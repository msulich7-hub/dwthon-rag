+import { z } from 'zod'
+
+export const forecastGranularitySchema = z.enum(['day', 'week', 'month'])
+export const forecastMetricSchema = z.enum(['revenue_gross'])
+export const forecastEngineSchema = z.enum(['naive', 'moving_average', 'seasonal_naive', 'arima'])
+
+export const predictBodySchema = z.object({
+  metric: forecastMetricSchema.default('revenue_gross'),
+  granularity: forecastGranularitySchema.default('week'),
+  engine: forecastEngineSchema.default('moving_average'),
+  horizon: z.number().int().min(1).max(52).default(12),
+  historyPeriods: z.number().int().min(4).max(156).default(52),
+  engineOptions: z.record(z.string(), z.unknown()).optional(),
+  persist: z.boolean().default(true),
+})
+
+export type PredictBody = z.infer<typeof predictBodySchema>
+
+export const runsListQuerySchema = z.object({
+  page: z.coerce.number().int().positive().default(1),
+  pageSize: z.coerce.number().int().positive().max(100).default(20),
+})
