+import { z } from 'zod'
+import type { OpenApiRouteDoc } from '@open-mercato/shared/lib/openapi'
+import { SalesForecastRun } from '../../data/entities'
+import { runsListQuerySchema } from '../../data/validators'
+import { json, resolveForecastRequestScope } from '../helpers'
+
+export const metadata = {
+  GET: { requireAuth: true, requireFeatures: ['sales_forecasting.view'] },
+}
+
+const runItemSchema = z.object({
+  id: z.string().uuid(),
+  metric: z.string(),
+  granularity: z.string(),
+  engine: z.string(),
+  horizon: z.number(),
+  createdAt: z.string(),
+  diagnostics: z.record(z.string(), z.unknown()).nullable(),
+})
+
+const listResponseSchema = z.object({
+  items: z.array(runItemSchema),
+  total: z.number(),
+  page: z.number(),
+  pageSize: z.number(),
+  totalPages: z.number(),
+})
+
+export async function GET(request: Request): Promise<Response> {
+  const scope = await resolveForecastRequestScope(request)
+  if (scope instanceof Response) return scope
+
+  const url = new URL(request.url)
+  const parsed = runsListQuerySchema.safeParse({
+    page: url.searchParams.get('page') ?? undefined,
+    pageSize: url.searchParams.get('pageSize') ?? undefined,
+  })
+  if (!parsed.success) {
+    return json({ error: 'Invalid query parameters' }, { status: 400 })
+  }
+
+  const { page, pageSize } = parsed.data
+  const em = scope.em.fork()
+  const where = {
+    tenantId: scope.tenantId,
+    organizationId: scope.organizationId,
+  }
+
+  const [items, total] = await em.findAndCount(SalesForecastRun, where, {
+    orderBy: { createdAt: 'DESC' },
+    limit: pageSize,
+    offset: (page - 1) * pageSize,
+  })
+
+  const totalPages = Math.max(1, Math.ceil(total / pageSize))
+
+  return json({
+    items: items.map((run) => ({
+      id: run.id,
+      metric: run.metric,
+      granularity: run.granularity,
+      engine: run.engine,
+      horizon: run.horizon,
+      createdAt: run.createdAt.toISOString(),
+      diagnostics: run.diagnostics ?? null,
+    })),
+    total,
+    page,
+    pageSize,
+    totalPages,
+  })
+}
+
+export const openApi: OpenApiRouteDoc = {
+  summary: 'List sales forecast runs',
+  description: 'Returns paginated forecast run history for the current organization.',
+  methods: {
+    GET: {
+      responses: {
+        200: { schema: listResponseSchema },
+      },
+    },
+  },
+}
