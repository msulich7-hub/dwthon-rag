@@ -0,0 +1,35 @@
+import type { ForecastEngine, ForecastEngineInput, ForecastEngineResult } from '../types'
+import { advancePeriodStart, lastHistoryPoint } from './period'
+
+function movingAverage(values: number[], window: number): number {
+  if (values.length === 0) return 0
+  const slice = values.slice(-window)
+  const sum = slice.reduce((acc, value) => acc + value, 0)
+  return sum / slice.length
+}
+
+export const movingAverageEngine: ForecastEngine = {
+  key: 'moving_average',
+  label: 'Moving average',
+  minimumHistoryPoints: 3,
+  run(input: ForecastEngineInput): ForecastEngineResult {
+    const windowRaw = input.options?.window
+    const window = typeof windowRaw === 'number' && windowRaw > 0 ? Math.floor(windowRaw) : 3
+    const values = input.history.map((point) => point.value)
+    const last = lastHistoryPoint(input.history)
+    const anchor = last?.periodStart ?? new Date().toISOString().slice(0, 10)
+    let rolling = [...values]
+    const forecast = Array.from({ length: input.horizon }, (_, index) => {
+      const value = movingAverage(rolling, window)
+      rolling = [...rolling, value]
+      return {
+        periodStart: advancePeriodStart(anchor, input.granularity, index + 1),
+        value,
+      }
+    })
+    return {
+      forecast,
+      diagnostics: { method: 'moving_average', window },
+    }
+  },
+}
