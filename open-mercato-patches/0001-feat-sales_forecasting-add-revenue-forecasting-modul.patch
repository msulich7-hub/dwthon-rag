--- /dev/null
+++ b/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/seasonalNaive.ts
@@ -0,0 +1,28 @@
+import type { ForecastEngine, ForecastEngineInput, ForecastEngineResult } from '../types'
+import { advancePeriodStart, lastHistoryPoint, seasonLengthForGranularity } from './period'
+
+export const seasonalNaiveEngine: ForecastEngine = {
+  key: 'seasonal_naive',
+  label: 'Seasonal naive',
+  minimumHistoryPoints: 8,
+  run(input: ForecastEngineInput): ForecastEngineResult {
+    const seasonLength = seasonLengthForGranularity(input.granularity)
+    const values = input.history.map((point) => point.value)
+    const last = lastHistoryPoint(input.history)
+    const anchor = last?.periodStart ?? new Date().toISOString().slice(0, 10)
+    const forecast = Array.from({ length: input.horizon }, (_, index) => {
+      const historyIndex = values.length - seasonLength + index
+      const value = historyIndex >= 0 && historyIndex < values.length
+        ? values[historyIndex]!
+        : values[values.length - 1] ?? 0
+      return {
+        periodStart: advancePeriodStart(anchor, input.granularity, index + 1),
+        value,
+      }
+    })
+    return {
+      forecast,
+      diagnostics: { method: 'seasonal_naive', seasonLength },
+    }
+  },
+}
