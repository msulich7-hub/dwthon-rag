--- /dev/null
+++ b/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/arima.ts
@@ -0,0 +1,60 @@
+import ARIMA from 'arima'
+import type { ForecastEngine, ForecastEngineInput, ForecastEngineResult } from '../types'
+import { advancePeriodStart, lastHistoryPoint } from './period'
+
+export const arimaEngine: ForecastEngine = {
+  key: 'arima',
+  label: 'ARIMA (AutoARIMA)',
+  minimumHistoryPoints: 8,
+  run(input: ForecastEngineInput): ForecastEngineResult {
+    const values = input.history.map((point) => point.value)
+    const last = lastHistoryPoint(input.history)
+    const anchor = last?.periodStart ?? new Date().toISOString().slice(0, 10)
+    const auto = input.options?.auto !== false
+    const seasonal = input.granularity === 'month'
+    try {
+      const model = new ARIMA({
+        auto,
+        verbose: false,
+        ...(seasonal ? { P: 1, D: 0, Q: 1, s: 12 } : {}),
+      }).train(values)
+      const predicted = model.predict(input.horizon) as number[] | number[][]
+      const flat = Array.isArray(predicted[0])
+        ? (predicted as number[][]).map((row) => row[0] ?? 0)
+        : (predicted as number[])
+      const padded = [...flat]
+      const lastValue = values[values.length - 1] ?? 0
+      while (padded.length < input.horizon) {
+        padded.push(lastValue)
+      }
+      const forecast = padded.slice(0, input.horizon).map((value, index) => ({
+        periodStart: advancePeriodStart(anchor, input.granularity, index + 1),
+        value: Number.isFinite(value) ? value : 0,
+      }))
+      return {
+        forecast,
+        diagnostics: {
+          method: 'arima',
+          auto,
+          seasonal,
+          library: 'arima@npm',
+        },
+      }
+    } catch (error) {
+      const message = error instanceof Error ? error.message : 'ARIMA failed'
+      const fallbackValue = values[values.length - 1] ?? 0
+      const forecast = Array.from({ length: input.horizon }, (_, index) => ({
+        periodStart: advancePeriodStart(anchor, input.granularity, index + 1),
+        value: fallbackValue,
+      }))
+      return {
+        forecast,
+        diagnostics: {
+          method: 'arima',
+          error: message,
+          fallback: 'naive_last_value',
+        },
+      }
+    }
+  },
+}
