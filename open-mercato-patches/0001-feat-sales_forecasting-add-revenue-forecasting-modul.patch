@@ -0,0 +1,98 @@
+import type { EntityManager } from '@mikro-orm/postgresql'
+import { SalesForecastRun } from '../data/entities'
+import type { PredictBody } from '../data/validators'
+import { aggregateSalesHistory } from '../lib/aggregateSalesHistory'
+import { getForecastEngine } from '../lib/engines/registry'
+import type { ForecastEngineKey, ForecastPoint, TimeSeriesPoint } from '../lib/types'
+
+export type RunForecastParams = {
+  em: EntityManager
+  tenantId: string
+  organizationId: string
+  userId?: string | null
+  input: PredictBody
+}
+
+export type RunForecastResult = {
+  runId: string | null
+  engine: ForecastEngineKey
+  metric: PredictBody['metric']
+  granularity: PredictBody['granularity']
+  history: TimeSeriesPoint[]
+  forecast: ForecastPoint[]
+  diagnostics: Record<string, unknown>
+}
+
+export async function runSalesForecast(params: RunForecastParams): Promise<RunForecastResult> {
+  const { em, tenantId, organizationId, userId, input } = params
+  const engine = getForecastEngine(input.engine)
+  if (!engine) {
+    throw new Error(`Unknown forecast engine: ${input.engine}`)
+  }
+
+  const history = await aggregateSalesHistory({
+    em,
+    tenantId,
+    organizationId,
+    metric: input.metric,
+    granularity: input.granularity,
+    historyPeriods: input.historyPeriods,
+  })
+
+  if (history.length < engine.minimumHistoryPoints) {
+    return {
+      runId: null,
+      engine: input.engine,
+      metric: input.metric,
+      granularity: input.granularity,
+      history,
+      forecast: [],
+      diagnostics: {
+        error: 'insufficient_history',
+        historyCount: history.length,
+        minimumPoints: engine.minimumHistoryPoints,
+      },
+    }
+  }
+
+  const engineResult = await engine.run({
+    history,
+    horizon: input.horizon,
+    granularity: input.granularity,
+    options: input.engineOptions,
+  })
+
+  const diagnostics: Record<string, unknown> = {
+    historyCount: history.length,
+    minimumPoints: engine.minimumHistoryPoints,
+    ...engineResult.diagnostics,
+  }
+
+  let runId: string | null = null
+  if (input.persist) {
+    const run = em.create(SalesForecastRun, {
+      tenantId,
+      organizationId,
+      metric: input.metric,
+      granularity: input.granularity,
+      engine: input.engine,
+      horizon: input.horizon,
+      historyPoints: history,
+      forecastPoints: engineResult.forecast,
+      diagnostics,
+      createdByUserId: userId ?? null,
+    })
+    await em.persistAndFlush(run)
+    runId = run.id
+  }
+
+  return {
+    runId,
+    engine: input.engine,
+    metric: input.metric,
+    granularity: input.granularity,
+    history,
+    forecast: engineResult.forecast,
+    diagnostics,
+  }
+}
