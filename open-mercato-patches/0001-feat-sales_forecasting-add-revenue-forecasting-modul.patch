+import { arimaEngine } from '../arima'
+import { movingAverageEngine } from '../movingAverage'
+import { naiveEngine } from '../naive'
+import { seasonalNaiveEngine } from '../seasonalNaive'
+
+const sampleHistory = Array.from({ length: 24 }, (_, index) => ({
+  periodStart: `2025-01-${String((index % 28) + 1).padStart(2, '0')}`,
+  value: 1000 + index * 10 + (index % 4) * 50,
+}))
+
+describe('forecast engines', () => {
+  it('naive repeats last value', () => {
+    const result = naiveEngine.run({
+      history: sampleHistory,
+      horizon: 3,
+      granularity: 'week',
+    })
+    expect(result.forecast).toHaveLength(3)
+    const lastValue = sampleHistory[sampleHistory.length - 1]!.value
+    expect(result.forecast.every((point) => point.value === lastValue)).toBe(true)
+  })
+
+  it('moving average produces horizon points', () => {
+    const result = movingAverageEngine.run({
+      history: sampleHistory,
+      horizon: 4,
+      granularity: 'week',
+      options: { window: 4 },
+    })
+    expect(result.forecast).toHaveLength(4)
+    expect(result.forecast[0]!.value).toBeGreaterThan(0)
+  })
+
+  it('seasonal naive produces horizon points', () => {
+    const result = seasonalNaiveEngine.run({
+      history: sampleHistory,
+      horizon: 2,
+      granularity: 'month',
+    })
+    expect(result.forecast).toHaveLength(2)
+  })
+
+  it('arima runs without throwing on sufficient history', () => {
+    const result = arimaEngine.run({
+      history: sampleHistory,
+      horizon: 3,
+      granularity: 'week',
+      options: { auto: true },
+    })
+    expect(result.forecast).toHaveLength(3)
+    expect(result.diagnostics.method).toBe('arima')
+  })
+})
diff --git a/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/arima.ts b/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/arima.ts
