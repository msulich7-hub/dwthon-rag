+import type { ForecastEngine, ForecastEngineKey } from '../types'
+import { arimaEngine } from './arima'
+import { movingAverageEngine } from './movingAverage'
+import { naiveEngine } from './naive'
+import { seasonalNaiveEngine } from './seasonalNaive'
+
+const engines: ForecastEngine[] = [
+  naiveEngine,
+  movingAverageEngine,
+  seasonalNaiveEngine,
+  arimaEngine,
+]
+
+const engineByKey = new Map<ForecastEngineKey, ForecastEngine>(
+  engines.map((engine) => [engine.key, engine]),
+)
+
+export function listForecastEngines(): ForecastEngine[] {
+  return [...engines]
+}
+
+export function getForecastEngine(key: ForecastEngineKey): ForecastEngine | undefined {
+  return engineByKey.get(key)
+}
+
+export function isForecastEngineKey(value: string): value is ForecastEngineKey {
+  return engineByKey.has(value as ForecastEngineKey)
+}
diff --git a/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/seasonalNaive.ts b/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/seasonalNaive.ts
new file mode 100644
