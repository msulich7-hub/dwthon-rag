+import { Entity, Index, PrimaryKey, Property } from '@mikro-orm/decorators/legacy'
+import type { ForecastEngineKey, ForecastGranularity, ForecastMetric, ForecastPoint, TimeSeriesPoint } from '../lib/types'
+
+@Entity({ tableName: 'sales_forecast_runs' })
+@Index({ name: 'sales_forecast_runs_org_tenant_idx', properties: ['organizationId', 'tenantId'] })
+@Index({ name: 'sales_forecast_runs_created_idx', properties: ['organizationId', 'tenantId', 'createdAt'] })
+export class SalesForecastRun {
+  @PrimaryKey({ type: 'uuid', defaultRaw: 'gen_random_uuid()' })
+  id!: string
+
+  @Property({ name: 'organization_id', type: 'uuid' })
+  organizationId!: string
+
+  @Property({ name: 'tenant_id', type: 'uuid' })
+  tenantId!: string
+
+  @Property({ type: 'text' })
+  metric!: ForecastMetric
+
+  @Property({ type: 'text' })
+  granularity!: ForecastGranularity
+
+  @Property({ type: 'text' })
+  engine!: ForecastEngineKey
+
+  @Property({ type: 'int' })
+  horizon!: number
+
+  @Property({ name: 'history_points', type: 'jsonb' })
+  historyPoints!: TimeSeriesPoint[]
+
+  @Property({ name: 'forecast_points', type: 'jsonb' })
+  forecastPoints!: ForecastPoint[]
+
+  @Property({ type: 'jsonb', nullable: true })
+  diagnostics?: Record<string, unknown> | null
+
+  @Property({ name: 'created_by_user_id', type: 'uuid', nullable: true })
+  createdByUserId?: string | null
+
+  @Property({ name: 'created_at', type: Date, onCreate: () => new Date() })
+  createdAt: Date = new Date()
+
+  @Property({ name: 'updated_at', type: Date, onUpdate: () => new Date() })
+  updatedAt: Date = new Date()
+}
