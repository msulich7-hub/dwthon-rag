@@ -0,0 +1,31 @@
+import type { ForecastGranularity } from '../types'
+
+export function advancePeriodStart(
+  anchorIsoDate: string,
+  granularity: ForecastGranularity,
+  steps: number,
+): string {
+  const date = new Date(`${anchorIsoDate}T00:00:00.000Z`)
+  if (Number.isNaN(date.getTime())) {
+    return anchorIsoDate
+  }
+  if (granularity === 'day') {
+    date.setUTCDate(date.getUTCDate() + steps)
+  } else if (granularity === 'week') {
+    date.setUTCDate(date.getUTCDate() + steps * 7)
+  } else {
+    date.setUTCMonth(date.getUTCMonth() + steps)
+  }
+  return date.toISOString().slice(0, 10)
+}
+
+export function lastHistoryPoint<T extends { periodStart: string }>(history: T[]): T | undefined {
+  if (history.length === 0) return undefined
+  return history[history.length - 1]
+}
+
+export function seasonLengthForGranularity(granularity: ForecastGranularity): number {
+  if (granularity === 'day') return 7
+  if (granularity === 'week') return 52
+  return 12
+}
diff --git a/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/registry.ts b/packages/sales-forecasting/src/modules/sales_forecasting/lib/engines/registry.ts
