+"use client"
+
+import * as React from 'react'
+import { Page, PageBody } from '@open-mercato/ui/backend/Page'
+import { Button } from '@open-mercato/ui/primitives/button'
+import { Input } from '@open-mercato/ui/primitives/input'
+import { Label } from '@open-mercato/ui/primitives/label'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@open-mercato/ui/primitives/select'
+import { Alert, AlertDescription, AlertTitle } from '@open-mercato/ui/primitives/alert'
+import { Spinner } from '@open-mercato/ui/primitives/spinner'
+import { apiCall } from '@open-mercato/ui/backend/utils/apiCall'
+import { flash } from '@open-mercato/ui/backend/FlashMessages'
+import { useT } from '@open-mercato/shared/lib/i18n/context'
+import { useOrganizationScopeVersion } from '@open-mercato/shared/lib/frontend/useOrganizationScope'
+
+type SeriesPoint = { periodStart: string; value: number }
+
+type PredictResponse = {
+  runId: string | null
+  engine: string
+  metric: string
+  granularity: string
+  history: SeriesPoint[]
+  forecast: SeriesPoint[]
+  diagnostics: Record<string, unknown>
+  error?: string
+}
+
+function formatValue(value: number): string {
+  return new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 }).format(value)
+}
+
+export default function SalesForecastingPage() {
+  const t = useT()
+  const scopeVersion = useOrganizationScopeVersion()
+  const [granularity, setGranularity] = React.useState<'day' | 'week' | 'month'>('week')
+  const [engine, setEngine] = React.useState('moving_average')
+  const [horizon, setHorizon] = React.useState('12')
+  const [historyPeriods, setHistoryPeriods] = React.useState('52')
+  const [isRunning, setIsRunning] = React.useState(false)
+  const [result, setResult] = React.useState<PredictResponse | null>(null)
+
+  const runForecast = React.useCallback(async () => {
+    setIsRunning(true)
+    try {
+      const call = await apiCall<PredictResponse>('/api/sales_forecasting/predict', {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({
+          granularity,
+          engine,
+          horizon: Number.parseInt(horizon, 10) || 12,
+          historyPeriods: Number.parseInt(historyPeriods, 10) || 52,
+          metric: 'revenue_gross',
+          persist: true,
+        }),
+      })
+      if (!call.ok) {
+        const message = (call.result as { error?: string } | undefined)?.error
+          ?? t('sales_forecasting.page.runError')
+        flash(message, 'error')
+        return
+      }
+      setResult(call.result ?? null)
+      flash(t('sales_forecasting.page.runSuccess'), 'success')
+    } finally {
+      setIsRunning(false)
+    }
+  }, [engine, granularity, historyPeriods, horizon, t])
+
+  React.useEffect(() => {
+    setResult(null)
+  }, [scopeVersion])
+
+  const insufficientHistory = result?.diagnostics?.error === 'insufficient_history'
+
+  return (
+    <Page>
+      <PageBody>
+        <div className="flex flex-col gap-6 max-w-4xl">
+          <div>
+            <h1 className="text-2xl font-semibold">{t('sales_forecasting.nav.title')}</h1>
+            <p className="text-muted-foreground mt-1">{t('sales_forecasting.page.description')}</p>
+          </div>
+
+          <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+            <div className="space-y-2">
+              <Label>{t('sales_forecasting.page.granularity')}</Label>
+              <Select value={granularity} onValueChange={(v) => setGranularity(v as typeof granularity)}>
+                <SelectTrigger>
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="day">{t('sales_forecasting.granularity.day')}</SelectItem>
+                  <SelectItem value="week">{t('sales_forecasting.granularity.week')}</SelectItem>
+                  <SelectItem value="month">{t('sales_forecasting.granularity.month')}</SelectItem>
+                </SelectContent>
+              </Select>
+            </div>
+            <div className="space-y-2">
+              <Label>{t('sales_forecasting.page.engine')}</Label>
+              <Select value={engine} onValueChange={setEngine}>
+                <SelectTrigger>
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="naive">{t('sales_forecasting.engine.naive')}</SelectItem>
+                  <SelectItem value="moving_average">{t('sales_forecasting.engine.moving_average')}</SelectItem>
+                  <SelectItem value="seasonal_naive">{t('sales_forecasting.engine.seasonal_naive')}</SelectItem>
+                  <SelectItem value="arima">{t('sales_forecasting.engine.arima')}</SelectItem>
+                </SelectContent>
+              </Select>
+            </div>
+            <div className="space-y-2">
+              <Label htmlFor="horizon">{t('sales_forecasting.page.horizon')}</Label>
+              <Input id="horizon" type="number" min={1} max={52} value={horizon} onChange={(e) => setHorizon(e.target.value)} />
+            </div>
+            <div className="space-y-2">
+              <Label htmlFor="history">{t('sales_forecasting.page.historyPeriods')}</Label>
+              <Input id="history" type="number" min={4} max={156} value={historyPeriods} onChange={(e) => setHistoryPeriods(e.target.value)} />
+            </div>
+          </div>
+
+          <div>
+            <Button onClick={() => void runForecast()} disabled={isRunning}>
+              {isRunning ? <Spinner className="mr-2 h-4 w-4" /> : null}
+              {t('sales_forecasting.page.run')}
+            </Button>
+          </div>
+
+          {insufficientHistory ? (
+            <Alert variant="destructive">
+              <AlertTitle>{t('sales_forecasting.page.insufficientTitle')}</AlertTitle>
+              <AlertDescription>
+                {t('sales_forecasting.page.insufficientDescription', {
+                  count: String(result?.diagnostics?.historyCount ?? 0),
+                  minimum: String(result?.diagnostics?.minimumPoints ?? 0),
+                })}
+              </AlertDescription>
+            </Alert>
+          ) : null}
+
+          {result && !insufficientHistory ? (
+            <div className="grid gap-6 md:grid-cols-2">
+              <section>
+                <h2 className="text-lg font-medium mb-2">{t('sales_forecasting.page.historySection')}</h2>
+                <div className="border rounded-md divide-y max-h-80 overflow-auto">
+                  {result.history.map((point) => (
+                    <div key={point.periodStart} className="flex justify-between px-3 py-2 text-sm">
+                      <span>{point.periodStart}</span>
+                      <span className="font-mono">{formatValue(point.value)}</span>
+                    </div>
+                  ))}
+                </div>
+              </section>
+              <section>
+                <h2 className="text-lg font-medium mb-2">{t('sales_forecasting.page.forecastSection')}</h2>
+                <div className="border rounded-md divide-y max-h-80 overflow-auto">
+                  {result.forecast.map((point) => (
+                    <div key={point.periodStart} className="flex justify-between px-3 py-2 text-sm">
+                      <span>{point.periodStart}</span>
+                      <span className="font-mono">{formatValue(point.value)}</span>
+                    </div>
+                  ))}
+                </div>
+              </section>
+            </div>
+          ) : null}
+        </div>
+      </PageBody>
+    </Page>
+  )
+}
