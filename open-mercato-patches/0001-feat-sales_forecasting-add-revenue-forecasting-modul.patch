+import { z } from 'zod'
+import type { OpenApiRouteDoc } from '@open-mercato/shared/lib/openapi'
+import { predictBodySchema } from '../../data/validators'
+import { runSalesForecast } from '../../services/forecastService'
+import { json, resolveForecastRequestScope } from '../helpers'
+
+export const metadata = {
+  POST: { requireAuth: true, requireFeatures: ['sales_forecasting.run'] },
+}
+
+const responseSchema = z.object({
+  runId: z.string().uuid().nullable(),
+  engine: z.string(),
+  metric: z.string(),
+  granularity: z.string(),
+  history: z.array(z.object({ periodStart: z.string(), value: z.number() })),
+  forecast: z.array(z.object({
+    periodStart: z.string(),
+    value: z.number(),
+    lower: z.number().optional(),
+    upper: z.number().optional(),
+  })),
+  diagnostics: z.record(z.string(), z.unknown()),
+})
+
+const errorSchema = z.object({ error: z.string() })
+
+export async function POST(request: Request): Promise<Response> {
+  const scope = await resolveForecastRequestScope(request)
+  if (scope instanceof Response) return scope
+
+  const parsed = predictBodySchema.safeParse(await request.json().catch(() => ({})))
+  if (!parsed.success) {
+    return json({ error: 'Invalid request payload' }, { status: 400 })
+  }
+
+  const em = scope.em.fork()
+  try {
+    const result = await runSalesForecast({
+      em,
+      tenantId: scope.tenantId,
+      organizationId: scope.organizationId,
+      userId: scope.userId,
+      input: parsed.data,
+    })
+    return json(result)
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Forecast failed'
+    return json({ error: message }, { status: 500 })
+  }
+}
+
+export const openApi: OpenApiRouteDoc = {
+  summary: 'Run sales revenue forecast',
+  description: 'Aggregates sales order history and runs the selected forecasting engine.',
+  methods: {
+    POST: {
+      requestBody: predictBodySchema,
+      responses: {
+        200: { schema: responseSchema },
+        400: { schema: errorSchema },
+        401: { schema: errorSchema },
+        500: { schema: errorSchema },
+      },
+    },
+  },
+}
