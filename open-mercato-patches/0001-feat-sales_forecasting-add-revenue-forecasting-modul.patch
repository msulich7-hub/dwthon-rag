@@ -0,0 +1,34 @@
+export type ForecastGranularity = 'day' | 'week' | 'month'
+
+export type ForecastMetric = 'revenue_gross'
+
+export type ForecastEngineKey = 'naive' | 'moving_average' | 'seasonal_naive' | 'arima'
+
+export type TimeSeriesPoint = {
+  periodStart: string
+  value: number
+}
+
+export type ForecastPoint = TimeSeriesPoint & {
+  lower?: number
+  upper?: number
