diff --git a/packages/sales-forecasting/src/modules/sales_forecasting/lib/aggregateSalesHistory.ts b/packages/sales-forecasting/src/modules/sales_forecasting/lib/aggregateSalesHistory.ts
new file mode 100644
index 0000000..d50268f
--- /dev/null
+++ b/packages/sales-forecasting/src/modules/sales_forecasting/lib/aggregateSalesHistory.ts
@@ -0,0 +1,50 @@
+import type { EntityManager } from '@mikro-orm/postgresql'
+import type { ForecastGranularity, ForecastMetric, TimeSeriesPoint } from './types'
+
+const GRANULARITY_TRUNC: Record<ForecastGranularity, string> = {
+  day: 'day',
+  week: 'week',
+  month: 'month',
+}
+
+function metricExpression(metric: ForecastMetric): string {
+  if (metric === 'revenue_gross') {
+    return 'coalesce(sum(cast(so.grand_total_gross_amount as numeric)), 0)'
+  }
+  return '0'
+}
+
+export async function aggregateSalesHistory(params: {
+  em: EntityManager
+  tenantId: string
+  organizationId: string
+  metric: ForecastMetric
+  granularity: ForecastGranularity
+  historyPeriods: number
+}): Promise<TimeSeriesPoint[]> {
+  const { em, tenantId, organizationId, metric, granularity, historyPeriods } = params
+  const trunc = GRANULARITY_TRUNC[granularity]
+  const metricSql = metricExpression(metric)
+
+  const knex = em.getKnex()
+  const rows = await knex
+    .select(knex.raw(`date_trunc('${trunc}', coalesce(so.placed_at, so.created_at)) as period_start`))
+    .select(knex.raw(`${metricSql} as value`))
+    .from({ so: 'sales_orders' })
+    .where('so.tenant_id', tenantId)
+    .where('so.organization_id', organizationId)
+    .whereNull('so.deleted_at')
+    .groupByRaw(`date_trunc('${trunc}', coalesce(so.placed_at, so.created_at))`)
+    .orderBy('period_start', 'asc')
+
+  const points = rows.map((row: { period_start: Date | string; value: string | number }) => {
+    const periodDate = row.period_start instanceof Date ? row.period_start : new Date(row.period_start)
+    const value = typeof row.value === 'string' ? Number.parseFloat(row.value) : Number(row.value)
+    return {
+      periodStart: periodDate.toISOString().slice(0, 10),
+      value: Number.isFinite(value) ? value : 0,
+    }
+  })
+
+  return points.slice(-historyPeriods)
+}
