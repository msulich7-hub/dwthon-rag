{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercato.local/schemas/what-if-scenarios.registry.schema.json",
  "title": "Mercato What-If Scenario Registry",
  "type": "object",
  "required": ["version", "templates", "bundles"],
  "properties": {
    "version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "defaults": {
      "type": "object",
      "properties": {
        "proposeOnly": { "type": "boolean" },
        "parentScenarioId": { "type": ["string", "null"] },
        "horizonHours": { "type": "number" },
        "tier": { "enum": ["S", "M", "L", "XL"] },
        "dryRun": { "type": "boolean" }
      }
    },
    "objectiveProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tardinessWeight": { "type": "number" },
          "changeoverWeight": { "type": "number" },
          "wipWeight": { "type": "number" },
          "objective": { "enum": ["minimize_lateness", "minimize_changeover", "balance_load"] }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "namePl", "nameEn", "dimensions", "tier", "audience"],
        "properties": {
          "id": { "type": "string", "pattern": "^(T|WIF)-[0-9]{2}$" },
          "namePl": { "type": "string" },
          "nameEn": { "type": "string" },
          "dimensions": { "type": "array", "items": { "type": "string" } },
          "tier": { "enum": ["S", "M", "L", "XL"] },
          "audience": { "enum": ["planner", "sop", "exec", "analytics"] },
          "overrides": { "type": "object" },
          "expectedKpis": { "type": "array", "items": { "type": "string" } },
          "isBaseline": { "type": "boolean" }
        }
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "namePl", "mode", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^BND-[A-Z0-9-]+$" },
          "namePl": { "type": "string" },
          "mode": { "enum": ["cascade", "parallel", "tournament", "single"] },
          "maxDepth": { "type": "integer", "maximum": 3 },
          "steps": { "type": "array", "items": { "type": "string" } },
          "baseTemplate": { "type": "string" },
          "variants": { "type": "array" },
          "requiresModule": { "type": "string" }
        }
      }
    }
  }
}
