    {
      "id": "WIF-14",
      "namePl": "Rolling 14d",
      "nameEn": "Rolling horizon 14d",
      "dimensions": ["horizon"],
      "tier": "L",
      "overrides": { "horizonHours": 336, "rolling": { "enabled": true, "windowHours": 168, "overlapHours": 24 } }
    },
    {
      "id": "WIF-15",
      "namePl": "Chunk 3x500",
      "nameEn": "Chunk pipeline 3x500",
      "dimensions": ["horizon"],
      "tier": "L",
