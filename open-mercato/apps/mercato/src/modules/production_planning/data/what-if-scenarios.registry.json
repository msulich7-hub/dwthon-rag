      "nameEn": "WIP minimization",
      "dimensions": ["priority", "cost"],
      "tier": "M",
      "overrides": { "objectiveProfile": "flow_first" }
    },
    {
      "id": "WIF-17",
      "namePl": "Recovery z parent",
