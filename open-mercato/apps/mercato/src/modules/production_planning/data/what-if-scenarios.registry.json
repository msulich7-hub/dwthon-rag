      "dimensions": ["horizon"],
      "tier": "L",
      "audience": "sop",
      "overrides": { "horizonHours": 1344 },
      "expectedKpis": ["late_orders_down", "plan_churn_up"]
    },
    {
      "id": "T-15",
      "namePl": "As-of wczoraj",
      "nameEn": "As-of cut yesterday",
      "dimensions": ["horizon"],
      "tier": "M",
      "audience": "analytics",
      "overrides": { "asOf": { "offsetDays": -1 }, "antiFantasy": "strict" },
      "expectedKpis": ["chaos_premium_up", "exceptions_up"]
    },
    {
      "id": "T-16",
      "namePl": "OEE -10% bottleneck",
      "nameEn": "Bottleneck OEE minus 10",
      "dimensions": ["capacity"],
      "tier": "M",
      "audience": "planner",
      "overrides": { "capacity": { "oeeMultiplier": 0.9, "bottleneckOnly": true } },
