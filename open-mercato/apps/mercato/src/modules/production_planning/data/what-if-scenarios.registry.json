      "namePl": "Expedite fee OK",
      "nameEn": "Expedite fee accepted",
      "dimensions": ["cost", "priority"],
      "tier": "M",
      "audience": "exec",
      "overrides": { "cost": { "allowOvertimeAndSubcontract": true }, "objectiveProfile": "otif_first" },
      "expectedKpis": ["service_up", "margin_down", "chaos_premium_visible"]
    },
    {
      "id": "T-14",
      "namePl": "Horyzont 4→8 tyg.",
