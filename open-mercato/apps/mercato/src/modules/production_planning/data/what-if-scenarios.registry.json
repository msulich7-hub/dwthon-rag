      "dimensions": ["priority"],
      "tier": "M",
      "overrides": { "parentScenarioId": "WIF-01", "objectiveProfile": "otif_first" }
    },
    {
      "id": "WIF-18",
      "namePl": "Full cocktail",
      "nameEn": "Full constraint cocktail",
      "dimensions": ["capacity", "routing", "priority", "supply_disruption"],
