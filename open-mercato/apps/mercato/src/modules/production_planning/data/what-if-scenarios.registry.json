      "tier": "M",
      "audience": "planner",
      "overrides": { "supply": { "materialQtyCapPct": 70 } },
      "expectedKpis": ["unmet_pegged_demand"]
    },
    {
      "id": "T-06",
      "namePl": "Linia wyłączona 48h",
      "nameEn": "Line down 48h",
      "dimensions": ["capacity"],
      "tier": "M",
      "audience": "planner",
      "overrides": { "capacity": { "workCenterBlackoutHours": 48, "workCenterPattern": "CNC-*" } },
      "expectedKpis": ["tardiness_dependent_up"]
    },
    {
      "id": "T-07",
      "namePl": "Okno PM",
      "nameEn": "Planned maintenance",
      "dimensions": ["capacity", "horizon"],
      "tier": "M",
      "audience": "planner",
      "overrides": { "capacity": { "maintenanceWindow": true } },
