{
  "$schema": "./what-if-scenarios.registry.schema.json",
  "version": "1.0.0",
  "updated": "2026-05-24",
  "defaults": {
    "proposeOnly": true,
    "parentScenarioId": "WIF-01",
    "horizonHours": 168,
    "tier": "M",
    "dryRun": true
  },
  "objectiveProfiles": {
    "otif_first": { "tardinessWeight": 1.0, "changeoverWeight": 0.2, "wipWeight": 0.1, "objective": "minimize_lateness" },
    "balanced": { "tardinessWeight": 0.6, "changeoverWeight": 0.4, "wipWeight": 0.3, "objective": "minimize_lateness" },
    "campaign": { "tardinessWeight": 0.3, "changeoverWeight": 1.0, "wipWeight": 0.2, "objective": "minimize_changeover" },
    "flow_first": { "tardinessWeight": 0.4, "changeoverWeight": 0.3, "wipWeight": 1.0, "objective": "balance_load" },
    "cost_min": { "tardinessWeight": 0.2, "changeoverWeight": 0.5, "wipWeight": 0.8, "objective": "balance_load" }
  },
  "templates": [
    {
      "id": "T-01",
      "namePl": "Rush — VIP klient",
      "nameEn": "Rush order VIP",
      "dimensions": ["demand_shock", "priority"],
      "tier": "S",
      "audience": "planner",
      "overrides": { "objectiveProfile": "otif_first", "demand": { "insertRushOrder": true, "priorityMultiplier": 3 } },
      "expectedKpis": ["otif_target_up", "backlog_otif_down"]
    },
    {
      "id": "T-02",
      "namePl": "Szok popytu +20%",
      "nameEn": "Demand spike 20%",
      "dimensions": ["demand_shock", "horizon"],
      "tier": "M",
      "audience": "sop",
      "overrides": { "demand": { "forecastUpliftPct": 20 } },
      "expectedKpis": ["fill_rate_down", "tardy_orders_up"]
    },
    {
      "id": "T-03",
      "namePl": "Fala anulowań",
      "nameEn": "Cancellation wave",
      "dimensions": ["demand_shock"],
      "tier": "S",
      "audience": "planner",
      "overrides": { "demand": { "cancelLinesInRange": true } },
      "expectedKpis": ["utilization_down"]
    },
    {
      "id": "T-04",
      "namePl": "Opóźnienie dostawcy +7d",
      "nameEn": "Supplier delay 7d",
      "dimensions": ["supply_disruption"],
      "tier": "M",
      "audience": "planner",
      "overrides": { "supply": { "poDelayDays": 7 } },
      "expectedKpis": ["shortage_exceptions_up", "alt_routing_up"]
    },
    {
      "id": "T-05",
      "namePl": "Brak materiału (qty)",
